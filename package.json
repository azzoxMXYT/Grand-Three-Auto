{
  "name": "grand-three-auto",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test": "node --test src/*.test.js",
    "build:html": "npm run build && node scripts/standalone.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "three": "^0.181.0",
    "vite": "^7.2.2"
  },
  "description": "Pacific Drive — prototype original de conduite en monde ouvert",
  "author": "azzoxMXYT",
  "main": "electron/main.cjs",
  "private": true,
  "build": {
    "appId": "io.github.azzoxmxyt.pacificdrive",
    "productName": "Pacific Drive",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "Pacific-Drive-${version}-Portable-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pacific Drive",
      "artifactName": "Pacific-Drive-${version}-Installation-${arch}.${ext}"
    }
  }
}
